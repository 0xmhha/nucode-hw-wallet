{
  "name": "@nucode/hw-wallet",
  "version": "0.1.0",
  "description": "NuWallet multi-chain hardware wallet SDK — Ethereum and Solana over Web Bluetooth",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/protocol.test.js test/transport.test.js test/pin.test.js test/networks.test.js test/wordlist.test.js test/rlp.test.js test/eip712.test.js test/provider.test.js test/adapters.test.js test/conformance.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build && make -C ../firmware/test protocol_bridge",
    "test:device": "node --test test/device.test.js",
    "test:device:interactive": "NUWALLET_DEVICE_INTERACTIVE=1 node --test test/device.test.js"
  },
  "keywords": [
    "ethereum",
    "solana",
    "hardware-wallet",
    "web-bluetooth",
    "ed25519",
    "nrf52"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  }
}
